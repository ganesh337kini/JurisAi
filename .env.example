# Root reference only — copy values into each app’s own `.env` file.
#
# backend/.env
MONGODB_URI=mongodb://127.0.0.1:27017/jurisai
JWT_SECRET=change-me-to-a-long-random-string
PORT=5000
AI_SERVICE_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:5173
#
# frontend/.env (dev: proxy — recommended)
VITE_BACKEND_ORIGIN=http://127.0.0.1:5001
# Optional direct API URL for prod or if you skip the proxy:
# VITE_API_URL=http://127.0.0.1:5001/api
#
# ai-service/.env
CHROMA_PERSIST_DIR=./chroma_db
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
# TESSERACT_CMD=/opt/homebrew/bin/tesseract
# SUMMARIZER_MODEL=sshleifer/distilbart-cnn-12-6
