# Where Chroma persists on disk (relative to ai-service working directory).
CHROMA_PERSIST_DIR=./chroma_db

# Comma-separated origins allowed to call the AI service directly (mostly for debugging).
# The Node backend calls this service server-to-server, so CORS is not required for normal uploads.
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Optional: absolute path to tesseract binary if it is not on PATH.
# macOS Homebrew example:
# TESSERACT_CMD=/opt/homebrew/bin/tesseract

# Phase 2 — summarization model (HuggingFace id)
# Default: sshleifer/distilbart-cnn-12-6 (lighter, good for local dev)
# Alternatives: facebook/bart-large-cnn, t5-small
SUMMARIZER_MODEL=sshleifer/distilbart-cnn-12-6
